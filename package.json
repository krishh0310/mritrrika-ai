{
  "name": "mrittika-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent digitization for India's land records",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/ui",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mrittika/web",
    "build": "npm run build --workspace @mrittika/web",
    "lint": "npm run lint --workspace @mrittika/web",
    "typecheck": "npm run typecheck --workspace @mrittika/web && npm run typecheck --workspace @mrittika/mobile",
    "test": "npm run test --workspace @mrittika/web",
    "e2e": "playwright test --config apps/web/playwright.config.ts",
    "typecheck:web": "npm run typecheck --workspace @mrittika/web",
    "typecheck:mobile": "npm run typecheck --workspace @mrittika/mobile",
    "mobile": "npm run start --workspace @mrittika/mobile"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "~18.3.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
