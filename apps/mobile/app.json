{
  "expo": {
    "name": "Mrittika AI",
    "slug": "mrittika-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#1E3A5F", "resizeMode": "contain" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "ai.mrittika.demo" },
    "android": { "package": "ai.mrittika.demo" },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Mrittika needs the camera to photograph land records in the field."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:8000"
    }
  }
}
