# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
out/
apps/mobile/dist/
apps/mobile/.expo/
*.tsbuildinfo
.turbo/

# Secrets — never commit (§76)
.env
.env.local
.env.*.local
!.env.example

# Generated data — reproducible via scripts/, not tracked (§78 "datasets")
datasets/generated/
datasets/annotations/
datasets/splits/
datasets/reports/
datasets/gis/*.geojson
datasets/yolo-layout/
datasets/ocr-cache/
datasets/handwriting/
datasets/metadata/*.json

# Runtime output -- the LRMS file-drop outbox and similar
var/

# Model weights — never commit large binaries (§78 "models")
models/checkpoints/
# Ultralytics writes here when a run does not name a project directory.
runs/
*.pt
*.pdparams
*.pdmodel
*.onnx
*.safetensors

# Local infra state
# The Prometheus scrape token, mounted into the container at runtime.
.monitoring/
.minio-data/
.pgdata/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Test artifacts
playwright-report/
test-results/
htmlcov/
.coverage

# Screenshot helpers used during development
apps/web/shot.mjs
apps/web/flow.mjs
apps/web/test-results/

# Copied from node_modules by apps/web/scripts/copy-maplibre-worker.mjs
apps/web/public/maplibre/
