# expo-image-loader declares `"expo": "*"` as a peer dependency. With npm's
# automatic peer installation that resolves to the newest published Expo (57)
# rather than deduping onto the SDK 52 apps/mobile pins, which drags a second,
# newer Metro into the root of the tree. Bundling then dies: @expo/metro-config
# (SDK 52) reaches for `metro-cache/src/stores/FileStore`, and metro-cache 0.84
# added an `exports` map that no longer publishes that path.
#
# `overrides` does not fix this -- npm does not apply overrides to peers it
# installs automatically -- so the peer auto-install is turned off instead.
# Every workspace here declares what it actually imports.
legacy-peer-deps=true
