# Mrittika AI — environment template (§61)
# Copy to .env and fill in. NEVER commit .env.

# ─── Database ────────────────────────────────────────────────────────────────
# Custom image: PostGIS + pgvector (see infrastructure/docker/postgres/Dockerfile)
POSTGRES_USER=mrittika
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=mrittika
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mrittika:change_me_locally@localhost:5432/mrittika

# ─── Redis (Celery broker + result backend) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Object storage (MinIO) ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_locally
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=mrittika-documents
MINIO_BUCKET_DERIVED=mrittika-derived

# ─── Auth (§61) ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=generate_a_real_secret_do_not_use_this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_STATE_REDIS_URL=
LOGIN_RATE_LIMIT_FAILURES=5
LOGIN_RATE_LIMIT_IP_FAILURES=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AI_QUERY_RATE_LIMIT_USER=30
AI_QUERY_RATE_LIMIT_IP=60
AI_QUERY_RATE_LIMIT_WINDOW_SECONDS=60
AI_QUERY_DAILY_QUOTA=200

# ─── AI providers (§81 abstraction targets) ──────────────────────────────────
# No ANTHROPIC_API_KEY on the dev machine; Gemini is the LLM + embedding provider.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Fast fallback LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OCR: Gemini is the safe default on macOS; set to paddle only after verifying
# the local Paddle runtime is stable.
OCR_PROVIDER=gemini
# Text detector: empty = PP-OCRv5_server_det (accurate; 11-19 GB per process).
# PP-OCRv5_mobile_det uses ~1.8 GB and is ~3x faster, but extraction F1 drops 0.68 -> 0.57.
OCR_DETECTION_MODEL=
WORKER_CONCURRENCY=1              # OCR processes at once
WORKER_MAX_MEMORY_MB=4096         # recycle a worker process after a task leaves it above this
OCR_LANG=hi                       # NOT "devanagari" -- that is the internal
                                  # rec-model name and PaddleOCR rejects it as a lang

# ─── Model versions recorded on every prediction (§64) ───────────────────────
MODEL_VERSION_OCR=ocr-v1
MODEL_VERSION_EXTRACTOR=extractor-v1
MODEL_VERSION_ANOMALY=anomaly-v1

# ─── Upload limits (§61) ─────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_MIME=application/pdf,image/png,image/jpeg

# ─── App ─────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development

# ─── Demo seed (§70) — demo-only passwords, never production ─────────────────
DEMO_PASSWORD=demo_change_me

# --- Notifications (§19) ---------------------------------------------------
# All optional. With none of these set, the dispatcher records the delivery
# attempt and the in-app notification is still written, so the workflow behaves
# identically -- see apps/api/app/services/notification_service.py.

# WhatsApp Business Cloud API. Business-initiated messages need a template
# approved by Meta; the names are in TEMPLATES in notification_service.py.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# MSG91 (Indian SMS). India's DLT regime requires each template to be
# registered against a principal entity; a message without a valid DLT template
# ID is accepted by the API and dropped by the operator, so the provider
# refuses to send rather than report a false success. Register the templates,
# then put their IDs in TEMPLATES.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_PE_ID=

# --- Monitoring (§74) ------------------------------------------------------
# Prometheus cannot hold a JWT, so /metrics accepts a static scrape token as an
# alternative to the analytics:view permission. Unset means there is no token
# path at all -- a misconfigured scraper then fails to authenticate rather than
# silently publishing the exposition.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_SCRAPE_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# ── LRMS / DILRMP delivery (§14) ─────────────────────────────────────────────
# Approved records are queued and delivered by one adapter: file (JSON into a
# drop folder the state LRMS imports from), http (POST to LRMS_ENDPOINT with a
# bearer token), or disabled (queue only). See docs/lrms-integration.md.
LRMS_ADAPTER=file
# LRMS_OUTBOX_DIR=/var/lib/mrittika/lrms-outbox
LRMS_ENDPOINT=
LRMS_API_TOKEN=

# ── Email and push notifications (§19) ───────────────────────────────────────
# Unset SMTP_HOST = no email. Push goes to phones that registered an Expo token.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
EXPO_PUSH_ENABLED=true

# ── Vector search ────────────────────────────────────────────────────────────
# ngram (offline, lexical) or gemini (semantic; needs GEMINI_API_KEY). Changing
# it needs a reseed so vectors are rebuilt with the new model.
EMBEDDING_PROVIDER=ngram

# ── Part A: detector, translation, features ──────────────────────────────────
# YOLO layout detector in the pipeline (off: +0.001 F1 measured).
USE_YOLO=false
# IndicTrans2 translate-to-Hindi fallback for bn/gu/pa/or/ml pages that native
# labels cannot read. The model is gated on Hugging Face.
INDICTRANS2_ENABLED=false
# Trained handwriting detector + reader (docs/handwriting.md). Used when their
# weights exist under models/checkpoints/handwriting/; false forces the old
# heuristic-flag-only path.
HANDWRITING_MODELS_ENABLED=true
# Gemini re-reads each handwritten line as a second opinion on the local
# reader (or reads alone if there is none). Sends line crops to Google.
GEMINI_HANDWRITING_ENABLED=false
# pg_featureserv, reached only through /api/v1/geo/features.
PG_FEATURESERV_URL=http://localhost:9000
GEOSERVER_READER_PASSWORD=change_me_locally

# ── Part B: nightly retraining ───────────────────────────────────────────────
RETRAIN_SCHEDULER_ENABLED=true
# Accepted verifier corrections since the last run needed to retrain.
RETRAIN_MIN_SAMPLES=50

# ── Part C: DILRMP / LRMS connectors (docs/dilrmp-integration.md) ────────────
# Unset = mock mode: nothing leaves the system and integration_log says "mock".
DILRMP_ENDPOINT=
DILRMP_API_KEY=
LRMS_API_KEY=
