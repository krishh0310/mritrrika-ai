{
  "_comment": [
    "Tunable pipeline parameters, kept out of the code so a threshold can be",
    "changed without a deploy. The values here are the defaults the services",
    "fall back to; §8 forbids averaging confidence signals blindly, so the",
    "weights are explicit and inspectable."
  ],
  "quality": {
    "reject_below": 0.25,
    "rescan_below": 0.40,
    "warn_below": 0.65
  },
  "confidence": {
    "weights": {
      "ocr": 0.35,
      "extraction": 0.25,
      "layout": 0.18,
      "validation": 0.12,
      "language": 0.10
    },
    "bands": { "high": 0.85, "medium": 0.60 }
  },
  "anomaly": {
    "area_jump_ratio": 3.0,
    "high_mutation_rate_per_year": 1.0,
    "share_tolerance": 0.01,
    "isolation_forest": {
      "min_corpus": 30,
      "contamination": 0.05,
      "report_threshold": 0.55,
      "n_estimators": 100,
      "random_state": 42
    }
  }
}
